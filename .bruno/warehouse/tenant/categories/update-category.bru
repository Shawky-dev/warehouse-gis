meta {
  name: update-category
  type: http
  seq: 4
}

put {
  url: {{URL}}/{{TENANT_SLUG}}/categories/{{TENANT_CATEGORY_ID}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "name": "{{TENANT_CATEGORY_UPDATED_NAME}}",
    "code": "{{TENANT_CATEGORY_CODE}}",
    "displayName": "{{TENANT_CATEGORY_UPDATED_NAME}}",
    "description": "{{TENANT_CATEGORY_DESCRIPTION}}",
    "requiredZoneTypeId": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
