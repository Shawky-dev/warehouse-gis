meta {
  name: create-uom
  type: http
  seq: 3
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/uoms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "code": "{{TENANT_UOM_CODE}}",
    "name": "{{TENANT_UOM_NAME}}",
    "symbol": "{{TENANT_UOM_SYMBOL}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
