meta {
  name: update-product
  type: http
  seq: 4
}

put {
  url: {{URL}}/{{TENANT_SLUG}}/products/{{TENANT_PRODUCT_ID}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "sku": "{{TENANT_PRODUCT_SKU}}",
    "name": "{{TENANT_PRODUCT_NAME}} Updated",
    "description": "Updated description",
    "baseUomId": "{{TENANT_PRODUCT_BASE_UOM_ID}}",
    "trackLot": {{TENANT_PRODUCT_TRACK_LOT}},
    "trackExpiry": {{TENANT_PRODUCT_TRACK_EXPIRY}},
    "supplierIds": [],
    "primarySupplierId": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
