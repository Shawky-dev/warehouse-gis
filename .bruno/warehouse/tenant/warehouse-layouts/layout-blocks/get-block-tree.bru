meta {
  name: get-block-tree
  type: http
  seq: 1
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/warehouse-layouts/{{LAYOUT_ID}}/blocks
  body: none
  auth: bearer
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

vars:pre-request {
  LAYOUT_ID: e1c399c0-a33c-4dca-8ba5-b9a8b4ead4b8
}

settings {
  encodeUrl: true
  timeout: 0
}
