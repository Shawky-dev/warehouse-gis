meta {
  name: create-layout
  type: http
  seq: 3
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/warehouse-layouts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "name": "Standard Layout",
    "description": "Default 6-level aisle/side/bay/level/shelf structure"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
