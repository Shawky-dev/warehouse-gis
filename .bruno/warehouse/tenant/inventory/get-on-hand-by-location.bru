meta {
  name: get-on-hand-by-location
  type: http
  seq: 2
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/inventory/on-hand/by-location/{{LOCATION_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}
