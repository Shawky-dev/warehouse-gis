meta {
  name: deactivate-hazard-type
  type: http
  seq: 5
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/hazard-types/{{HAZARD_TYPE_ID}}/deactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}
