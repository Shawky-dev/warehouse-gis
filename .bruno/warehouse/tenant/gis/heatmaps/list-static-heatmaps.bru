meta {
  name: list-static-heatmaps
  type: http
  seq: 1
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/gis/heatmaps/static
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns all ACTIVE static heatmaps for the tenant.

  Required permission: gis.heatmaps.view (ADMIN, MANAGER)

  Response: array of static heatmap records
  [
    {
      "id": "<uuid>",
      "name": "Summer Floor Plan",
      "sourceFilename": "summer_plan.tiff",
      "isDefault": true,
      "createdAt": "2026-04-06T10:00:00Z",
      "updatedAt": "2026-04-06T10:00:00Z"
    }
  ]
}
