meta {
  name: delete-static-heatmap
  type: http
  seq: 4
}

delete {
  url: {{URL}}/{{TENANT_SLUG}}/gis/heatmaps/static/{{HEATMAP_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Deletes a static heatmap: removes the GeoServer coverage store first, then the DB record.
  If the deleted heatmap was the default and other active heatmaps remain, the newest active
  heatmap is promoted to default automatically.
  If GeoServer deletion succeeds but the DB operation fails, the row is marked ORPHANED
  so it is excluded from all normal queries.

  Required permission: gis.heatmaps.manage (ADMIN, MANAGER)

  Path variables:
    HEATMAP_ID  — UUID of the static heatmap to delete

  Response: 204 No Content on success.
}
