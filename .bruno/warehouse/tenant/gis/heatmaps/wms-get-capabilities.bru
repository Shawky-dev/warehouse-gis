meta {
  name: wms-get-capabilities
  type: http
  seq: 7
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/gis/wms?SERVICE=WMS&REQUEST=GetCapabilities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Proxies a WMS GetCapabilities request through Spring Boot to the tenant GeoServer workspace.
  Only SERVICE=WMS and approved REQUEST types are forwarded.
  Returns the GeoServer capabilities XML for the tenant workspace.

  Required permission: gis.heatmaps.view (ADMIN, MANAGER)

  Response: text/xml — WMS GetCapabilities document.
}
