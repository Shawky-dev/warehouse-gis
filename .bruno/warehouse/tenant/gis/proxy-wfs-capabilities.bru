meta {
  name: proxy-wfs-capabilities
  type: http
  seq: 3
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/gis/proxy/ows?service=WFS&version=2.0.0&request=GetCapabilities
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Proxies a WFS GetCapabilities request to GeoServer for this tenant's workspace (wh_<tenantSlug>).
  Lists all available feature type layers (one per BlockTemplate type after regenerate-layout).

  Required permission: gis.layout.view
}
