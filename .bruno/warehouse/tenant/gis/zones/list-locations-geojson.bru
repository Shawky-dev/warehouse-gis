meta {
  name: list-locations-geojson
  type: http
  seq: 2
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/gis/locations/geojson
  body: none
  auth: bearer
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns a GeoJSON FeatureCollection of all leaf-level (selectable) location polygons.
  A leaf is a gis_blocks row whose layoutBlockId has no children in layout_blocks.

  Required permission: gis.zones.view (ADMIN, MANAGER)

  Response: GeoJSON FeatureCollection
  {
    "type": "FeatureCollection",
    "features": [
      {
        "type": "Feature",
        "id": "<gisBlockId>",
        "geometry": { "type": "Polygon", "coordinates": [[[lon, lat], ...]] },
        "properties": {
          "locationId": "<layoutBlockId>",
          "label": "A-01-01",
          "positionPath": "1.1.1"
        }
      }
    ]
  }
}
