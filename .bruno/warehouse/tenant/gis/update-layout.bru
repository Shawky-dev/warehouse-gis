meta {
  name: update-layout
  type: http
  seq: 2
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/gis/layout/update
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Overwrites existing GIS shadow data using the current active layout.

  The endpoint first clears tenant GeoServer workspace resources,
  then rebuilds GIS rows and republishes layers/styles.

  Required permission: gis.layout.regenerate (ADMIN, MANAGER)

  Response:
  {
    "layersConverted": {
      "Zone": 2,
      "Aisle": 4,
      "Bay": 8,
      "Shelf": 24
    }
  }
}
