meta {
  name: proxy-wfs-getfeature
  type: http
  seq: 5
}

get {
  url: {{URL}}/{{TENANT_SLUG}}/gis/proxy/ows?service=WFS&version=2.0.0&request=GetFeature&typeNames=wh_{{TENANT_SLUG}}:{{TEMPLATE_NAME}}&outputFormat=application/json
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}

vars:pre-request {
  TEMPLATE_NAME: Aisle
}

docs {
  Proxies a WFS GetFeature request to GeoServer, returning all features for a given
  block template layer as GeoJSON.

  Required permission: gis.layout.view

  Query params:
    typeNames   — workspace:layerName, e.g. wh_acme:Aisle
                  The layer name matches the BlockTemplate name exactly (case-sensitive).
    outputFormat — application/json returns GeoJSON; text/xml returns GML

  Use {{TEMPLATE_NAME}} variable to switch between layers (Zone, Aisle, Bay, Level, Shelf).
}
