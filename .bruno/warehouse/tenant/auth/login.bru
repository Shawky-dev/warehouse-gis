meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/auth/login
  body: json
  auth: inherit
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "email": "{{TENANT_ADMIN_EMAIL}}",
    "password": "{{TENANT_ADMIN_PASSWORD}}"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
