meta {
  name: reactivate-zone-type
  type: http
  seq: 6
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/zone-types/{{ZONE_TYPE_ID}}/reactivate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

settings {
  encodeUrl: true
  timeout: 0
}
