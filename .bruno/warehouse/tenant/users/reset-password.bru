meta {
  name: reset-password
  type: http
  seq: 4
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/users/{{TENANT_USER_ID}}/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

body:json {
  {
    "newPassword": "{{TENANT_USER_NEW_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
