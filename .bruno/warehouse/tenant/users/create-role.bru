meta {
  name: create-role
  type: http
  seq: 10
}

post {
  url: {{URL}}/{{TENANT_SLUG}}/roles
  body: json
  auth: bearer
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "code": "{{TENANT_NEW_ROLE_CODE}}",
    "name": "{{TENANT_NEW_ROLE_NAME}}",
    "description": "{{TENANT_NEW_ROLE_DESCRIPTION}}",
    "locked": {{TENANT_NEW_ROLE_LOCKED}},
    "permissionCodes": [
      "tenant.users.view"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
