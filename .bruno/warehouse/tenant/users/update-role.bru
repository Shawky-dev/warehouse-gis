meta {
  name: update-role
  type: http
  seq: 9
}

put {
  url: {{URL}}/{{TENANT_SLUG}}/roles/{{TENANT_ROLE_CODE}}
  body: json
  auth: bearer
}

headers {
  X-TENANT-ID: {{TENANT_SLUG}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "Operations Manager",
    "description": "Can handle selected tenant operations",
    "locked": {{TENANT_ROLE_LOCKED}},
    "permissionCodes": [
      "tenant.users.view",
      "tenant.users.create",
      "tenant.users.edit",
      "tenant.users.reset_password",
      "tenant.users.deactivate",
      "tenant.users.reactivate",
      "tenant.roles.edit"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
