meta {
  name: reset-password
  type: http
  seq: 4
}

post {
  url: {{URL}}/landlord/users/{{LANDLORD_USER_ID}}/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: BOOTSTRAP
}

body:json {
  {
    "newPassword": "{{LANDLORD_USER_NEW_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
