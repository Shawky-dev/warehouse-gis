meta {
  name: create-tenant
  type: http
  seq: 2
}

post {
  url: {{URL}}/landlord/tenants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: BOOTSTRAP
}

body:json {
  {
    "tenantId": "{{TENANT_SLUG}}",
    "schema": "{{TENANT_SLUG}}",
    "admin": {
      "email": "{{TENANT_ADMIN_EMAIL}}",
      "password": "{{TENANT_ADMIN_PASSWORD}}"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
