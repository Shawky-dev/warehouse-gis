meta {
  name: create-tenant
  type: http
  seq: 2
}

post {
  url: {{URL}}/landlord/tenants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  X-TENANT-ID: BOOTSTRAP
}

body:json {
  {
    "tenantId": "acme",
    "schema": "acme"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
