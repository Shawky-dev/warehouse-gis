# Railway injects PORT automatically for web services.
# Only set PORT manually if you want Railway networking and health checks pinned to a specific port.
# Apply each section to its matching Railway service instead of importing this whole file into one service.

# =========================
# frontend service
# =========================
BACKEND_UPSTREAM=http://backend.railway.internal:8080
VITE_API_URL=/api

# =========================
# backend service
# =========================
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgis.railway.internal:5432/warehouse
SPRING_DATASOURCE_USERNAME=warehouse
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
SECURITY_JWT_ISSUER=warehouse-platform-api
SECURITY_JWT_AUDIENCE=warehouse-platform-web
SECURITY_JWT_ACCESS_TOKEN_TTL=10m
SECURITY_JWT_REFRESH_TOKEN_TTL=14d
SECURITY_JWT_KEY_ID=warehouse-k1-20260304
# Set both JWT key variables with `railway variable set --stdin` and paste full PEM contents.
SECURITY_JWT_PRIVATE_KEY=<paste-private-key-pem-via-stdin>
SECURITY_JWT_PUBLIC_KEY=<paste-public-key-pem-via-stdin>
SECURITY_AUTH_REFRESH_COOKIE_NAME=refresh_token
SECURITY_AUTH_REFRESH_COOKIE_PATH=/landlord/auth
SECURITY_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
SECURITY_AUTH_REFRESH_COOKIE_SECURE=true
SECURITY_AUTH_REFRESH_COOKIE_DOMAIN=
SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
GEOSERVER_URL=http://geoserver.railway.internal:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-with-geoserver-password
GEOSERVER_DB_HOST=postgis.railway.internal
GEOSERVER_DB_PORT=5432
GEOSERVER_DB_NAME=warehouse
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport

# =========================
# geoserver service
# =========================
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-with-geoserver-password
GEOSERVER_DATA_DIR=/opt/geoserver_data
INITIAL_MEMORY=512M
MAXIMUM_MEMORY=1G

# =========================
# postgis service
# =========================
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-with-database-password
