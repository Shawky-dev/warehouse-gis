# Compose project
COMPOSE_PROJECT_NAME=warehouse
FRONTEND_PORT=8080

# Database
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt

# Backend runtime
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport

# JWT
SECURITY_JWT_ISSUER=warehouse-platform-api
SECURITY_JWT_AUDIENCE=warehouse-platform-web
SECURITY_JWT_ACCESS_TOKEN_TTL=10m
SECURITY_JWT_REFRESH_TOKEN_TTL=14d
SECURITY_JWT_KEY_ID=warehouse-k1-20260304
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem

# Auth cookie (set secure=true and update domain when serving over HTTPS)
SECURITY_AUTH_REFRESH_COOKIE_NAME=refresh_token
SECURITY_AUTH_REFRESH_COOKIE_PATH=/landlord/auth
SECURITY_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
SECURITY_AUTH_REFRESH_COOKIE_SECURE=false
SECURITY_AUTH_REFRESH_COOKIE_DOMAIN=

# Frontend build-time API target
VITE_API_URL=/api

# Optional CORS origins (comma separated)
# Add your machine hostname explicitly if you browse via http://hostname:PORT.
SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.*:*,https://*.ngrok-free.dev,https://*.ngrok.app
