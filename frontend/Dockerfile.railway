# Runtime-only image for Railway deployment.
# Pre-build frontend locally first:
#   cd frontend && npm run build
# Then deploy:
#   railway up . --service frontend --path-as-root
FROM nginxinc/nginx-unprivileged:1.28-alpine

USER root
RUN apk add --no-cache gettext

COPY dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh

RUN chown -R 101:0 /usr/share/nginx/html /etc/nginx/conf.d /etc/nginx/templates /docker-entrypoint.sh \
  && chmod 500 /docker-entrypoint.sh

USER 101

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
